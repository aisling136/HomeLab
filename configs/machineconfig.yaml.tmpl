{{ define "machineconfigtemplate" -}}
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/metal-installer/{{ (datasource "inventory").talos_factory_key }}:{{ (datasource "inventory").talos_version }}
provisioning:
  diskSelector:
    match: disk.dev_path == "{{ .node.disk }}"
  wipe: false
---
machine:
  features:
    diskQuotaSupport: true
cluster:
  etcd:
    extraArgs:
      listen-metrics-urls: "http://0.0.0.0:2381"
---
apiVersion: v1alpha1
kind: KubeFlannelCNIConfig
$patch: delete
---
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
---
apiVersion: v1alpha1
kind: KubeletConfig
config:
  maxParallelImagePulls: 3
  serverTLSBootstrap: true
defaultRuntimeSeccompProfileEnabled: true
image: ghcr.io/siderolabs/kubelet:{{ (ds "inventory").kubernetes_version }}
---
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfsmount.conf
mode: 0o644
contents: |
  [ NFSMount_Global_Options ]
  nfsvers=4.2
  hard=True
  noatime=True
  rsize=1048576
  wsize=1048576
  nconnect=8
---
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: containerd
content: |
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
  [plugins."io.containerd.cri.v1.runtime"]
    device_ownership_from_security_context = true
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  fs.inotify.max_queued_events: 65536
  fs.inotify.max_user_instances: 8192
  fs.inotify.max_user_watches: 524288
  net.core.rmem_max: 2500000
  net.core.wmem_max: 2500000
---
apiVersion: v1alpha1
kind: KubeTalosAPIAccessConfig
allowedRoles:
  - os:admin
allowedKubernetesNamespaces:
  - kube-system
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - 192.168.3.0/24
taints:
labels:
  topology.kubernetes.io/region: main
  topology.kubernetes.io/zone: {{ .node.type }}
  {{- range $key, $value := .node.extraLabels }}
  {{ $key }} : {{ $value }}
  {{- end }}
---
apiVersion: v1alpha1
kind: KubeProxyConfig
image: registry.k8s.io/kube-proxy:{{ (ds "inventory").kubernetes_version }}
enabled: false
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
image: registry.k8s.io/kube-scheduler:{{ (ds "inventory").kubernetes_version }}
extraArgs:
  bind-address: "0.0.0.0"
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
image: registry.k8s.io/kube-controller-manager:{{ (ds "inventory").kubernetes_version }}
extraArgs:
  bind-address: "0.0.0.0"
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
image: registry.k8s.io/kube-apiserver:{{ (ds "inventory").kubernetes_version }}
certExtraSANs:
  - "{{ (ds "inventory").controlplane_proxy_hostname }}"
  - {{ (ds "inventory").controlplane_proxy_ip }}
  - {{ (ds "inventory").cluster_virtual_ip }}
  - 127.0.0.1
---
apiVersion: v1alpha1
kind: KubeAuditPolicyConfig
configuration:
  apiVersion: audit.k8s.io/v1
  kind: Policy
  rules:
    - level: Metadata
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: off
hostname: {{ .node.name }}
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: longhorn
provisioning:
  diskSelector:
    match: system_disk
  grow: false
  maxSize: 800GB
---
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
provisioning:
  diskSelector:
    match: system_disk
  grow: false
  maxSize: 100GB
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
podSubnets:
  - 10.42.0.0/16
serviceSubnets:
  - 10.96.0.0/12
---
apiVersion: v1alpha1
kind: KubeCoreDNSConfig
enabled: false
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: {{ .node.interface }}
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: {{ (ds "inventory").cluster_virtual_ip }}
link: {{ .node.interface }}
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  - address: 192.168.3.1
hostDNS:
  forwardKubeDNSToHost: false
{{ end }}

{{ defineDatasource "inventory" "configs/inventory.yaml" }}
{{- range $node := (datasource "inventory").nodes}}
{{- $ctx := dict "node" $node }}
{{- $outPath := printf "tmp/%s.yaml" $node.name }}
{{- tmpl.Exec "machineconfigtemplate" $ctx | file.Write $outPath }}
{{- end -}}
